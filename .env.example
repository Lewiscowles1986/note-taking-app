# PostHog browser analytics (Vite exposes only VITE_-prefixed values to the browser)
#
# VITE_POSTHOG_KEY is required for analytics to be included in a build at all:
# builds without it alias the analytics module to a stub (vite.config.ts) and
# ship no analytics SDK.
# VITE_POSTHOG_HOST is optional; when unset the SDK targets the EU region
# (https://eu.i.posthog.com).
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
