# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Every build target's output directory. The glob rather than a list per target
# because ad-hoc `--outDir` builds (dist-probe2, ...) otherwise land untracked.
dist*
release
*.local
# A stray repo-local npm cache/log dir, as distinct from the global ~/.npm.
.npm/
.npm-cache
.worktrees

# Local secrets. Vite loads .env* into the client bundle, and .env files are
# per-machine config, so none of them are committed. .env.example stays tracked.
.env
.env.*
!.env.example

# Electron writes these lock/socket symlinks into its working directory while
# running; they point at the user's profile and are meaningless to a clone.
SingletonCookie
SingletonLock
SingletonSocket

# electron-builder's local cache (downloaded dmg-builder bundles, ~100 MB), as
# distinct from its global ~/Library/Caches copy.
.eb-cache/

# Scratch/analysis artifacts
.ghcache/
.pw-browsers/

# Playwright E2E artifacts (baselines in e2e/*-snapshots stay tracked)
test-results/
playwright-report/
e2e/artifacts/
.seed-profile/
.seed-downloads/
.pw-browsers/
.ghcache/

# Vitest coverage report (npm run test:coverage)
coverage/

# Stryker mutation testing reports (npx stryker run)
reports/
.stryker-tmp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
